[Unit]
Description=南京安播智维平台 API（anbo_wx）
After=network-online.target mysql.service redis-server.service
Wants=network-online.target mysql.service redis-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yvesyuan
Group=www-data
WorkingDirectory=/home/yvesyuan/PycharmProjects/anbo_wx/backend
EnvironmentFile=/home/yvesyuan/PycharmProjects/anbo_wx/backend/.env
Environment=PYTHONUNBUFFERED=1
UMask=0027
ExecStart=/home/yvesyuan/PycharmProjects/anbo_wx/backend/.venv/bin/gunicorn \
  --workers 4 \
  --bind 127.0.0.1:7001 \
  --timeout 120 \
  --graceful-timeout 30 \
  --keep-alive 5 \
  --max-requests 5000 \
  --max-requests-jitter 500 \
  --access-logfile - \
  --error-logfile - \
  run:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/yvesyuan/PycharmProjects/anbo_wx/backend/uploads /home/yvesyuan/PycharmProjects/anbo_wx/backend/logs
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
