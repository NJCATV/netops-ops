[Unit]
Description=NetOps Platform API
After=network-online.target mysql.service redis-server.service
Wants=network-online.target mysql.service redis-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yvesyuan
Group=www-data
WorkingDirectory=/srv/netops/netops-littleProgram/backend
EnvironmentFile=/etc/netops/netops-littleProgram.env
Environment=PYTHONUNBUFFERED=1
UMask=0027
ExecStart=/srv/netops/netops-littleProgram/backend/.venv/bin/python -m gunicorn \
  --workers 4 \
  --bind 127.0.0.1:7001 \
  --timeout 120 \
  --graceful-timeout 30 \
  --keep-alive 5 \
  --max-requests 5000 \
  --max-requests-jitter 500 \
  --access-logfile - \
  --error-logfile - \
  run:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/netops/netops-littleProgram/backend/uploads /srv/netops/netops-littleProgram/backend/logs
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
